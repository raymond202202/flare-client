<Window x:Class="FlareWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FlareWin"
        Title="Flare" Height="760" Width="1180"
        MinHeight="520" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="{x:Static local:Theme.BgWindow}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

  <Window.Resources>

    <!-- ===== 聊天块模板：一个模板 + 六种 Kind 触发器（render-spec §3.2） ===== -->
    <DataTemplate x:Key="ChatItem">
      <Grid Margin="0,5">
        <Border x:Name="bubble" MaxWidth="760" HorizontalAlignment="Left"
                Background="{x:Static local:Theme.BgSoft}"
                BorderBrush="{x:Static local:Theme.BorderSoft}"
                BorderThickness="1" CornerRadius="12" Padding="14,10">
          <StackPanel>
            <TextBlock x:Name="author" Text="{Binding Author}"
                       FontSize="{x:Static local:Theme.FontSmall}"
                       Foreground="{x:Static local:Theme.TextSoft}"
                       Margin="0,0,0,3"
                       Visibility="{Binding Author, Converter={StaticResource EmptyToVis}, ConverterParameter=invert}" />
            <TextBlock x:Name="body" Text="{Binding Text}" TextWrapping="Wrap"
                       FontSize="{x:Static local:Theme.FontBody}"
                       Foreground="{x:Static local:Theme.TextMain}"
                       LineHeight="22" />
            <TextBlock x:Name="cursor" Text="▍" FontSize="{x:Static local:Theme.FontBody}"
                       Foreground="{x:Static local:Theme.Orange}"
                       Margin="0,2,0,0" Visibility="Collapsed" />
          </StackPanel>
        </Border>
      </Grid>
      <DataTemplate.Triggers>
        <!-- 用户：右对齐橙底白字 -->
        <DataTrigger Binding="{Binding Kind}" Value="User">
          <Setter TargetName="bubble" Property="HorizontalAlignment" Value="Right" />
          <Setter TargetName="bubble" Property="Background" Value="{x:Static local:Theme.Orange}" />
          <Setter TargetName="bubble" Property="BorderThickness" Value="0" />
          <Setter TargetName="bubble" Property="CornerRadius" Value="12,12,2,12" />
          <Setter TargetName="body" Property="Foreground" Value="White" />
        </DataTrigger>
        <!-- 助手：左对齐白底细边 -->
        <DataTrigger Binding="{Binding Kind}" Value="Assistant">
          <Setter TargetName="bubble" Property="Background" Value="{x:Static local:Theme.BgSoft}" />
        </DataTrigger>
        <!-- 系统：居中无气泡 -->
        <DataTrigger Binding="{Binding Kind}" Value="System">
          <Setter TargetName="bubble" Property="HorizontalAlignment" Value="Center" />
          <Setter TargetName="bubble" Property="Background" Value="Transparent" />
          <Setter TargetName="bubble" Property="BorderThickness" Value="0" />
          <Setter TargetName="bubble" Property="Padding" Value="6,2" />
          <Setter TargetName="body" Property="Foreground" Value="{x:Static local:Theme.TextMuted}" />
          <Setter TargetName="body" Property="FontSize" Value="{x:Static local:Theme.FontSmall}" />
          <Setter TargetName="author" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <!-- 工具调用：等宽、浅黄背景 -->
        <DataTrigger Binding="{Binding Kind}" Value="Tool">
          <Setter TargetName="bubble" Property="Background" Value="{x:Static local:Theme.BgAlt}" />
          <Setter TargetName="bubble" Property="CornerRadius" Value="8" />
          <Setter TargetName="body" Property="FontFamily" Value="{x:Static local:Theme.FontMono}" />
          <Setter TargetName="body" Property="FontSize" Value="{x:Static local:Theme.FontSmall}" />
        </DataTrigger>
        <!-- 工具结果：等宽、更淡 -->
        <DataTrigger Binding="{Binding Kind}" Value="ToolResult">
          <Setter TargetName="bubble" Property="Background" Value="{x:Static local:Theme.BgSoft}" />
          <Setter TargetName="bubble" Property="CornerRadius" Value="8" />
          <Setter TargetName="body" Property="FontFamily" Value="{x:Static local:Theme.FontMono}" />
          <Setter TargetName="body" Property="FontSize" Value="{x:Static local:Theme.FontSmall}" />
          <Setter TargetName="body" Property="Foreground" Value="{x:Static local:Theme.TextSoft}" />
        </DataTrigger>
        <!-- 流式光标 -->
        <DataTrigger Binding="{Binding Streaming}" Value="True">
          <Setter TargetName="cursor" Property="Visibility" Value="Visible" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ===== 侧栏会话项 ===== -->
    <DataTemplate x:Key="SessionItem">
      <StackPanel>
        <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"
                   FontSize="{x:Static local:Theme.FontList}"
                   Foreground="{x:Static local:Theme.TextMain}" />
        <TextBlock Text="{Binding Preview}" TextTrimming="CharacterEllipsis"
                   FontSize="{x:Static local:Theme.FontFootnote}"
                   Foreground="{x:Static local:Theme.TextMuted}"
                   Margin="0,2,0,0"
                   Visibility="{Binding Preview, Converter={StaticResource EmptyToVis}, ConverterParameter=invert}" />
      </StackPanel>
    </DataTemplate>

  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="252" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ============ 侧栏 ============ -->
    <Border Grid.Column="0" Background="#fffdf7"
            BorderBrush="{x:Static local:Theme.BorderSoft}" BorderThickness="0,0,1,0">
      <Grid Margin="12,14,12,10">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 品牌 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,0,0,12">
          <Border Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center"
                  Background="{x:Static local:Theme.Orange}" />
          <TextBlock Text="Flare" FontSize="17" FontWeight="Bold" Margin="8,0,0,0"
                     Foreground="{x:Static local:Theme.TextMain}" VerticalAlignment="Center" />
          <TextBlock x:Name="SideVersion" FontSize="{x:Static local:Theme.FontFootnote}"
                     Foreground="{x:Static local:Theme.TextFaint}" Margin="8,3,0,0"
                     VerticalAlignment="Center" />
        </StackPanel>

        <!-- 新建对话 -->
        <Button Grid.Row="1" Content="＋  新对话" Style="{StaticResource PrimaryBtn}"
                HorizontalAlignment="Stretch" Margin="0,0,0,10"
                Click="OnNewChat" />

        <!-- 会话列表 -->
        <Grid Grid.Row="2">
          <ListBox x:Name="SessionList"
                   ItemsSource="{Binding Sessions}"
                   ItemTemplate="{StaticResource SessionItem}"
                   ItemContainerStyle="{StaticResource SideItem}"
                   BorderThickness="0" Background="Transparent"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   SelectionChanged="OnSessionSelected" />
          <TextBlock Text="还没有会话" FontSize="{x:Static local:Theme.FontSmall}"
                     Foreground="{x:Static local:Theme.TextFaint}"
                     HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0"
                     Visibility="{Binding Sessions.Count, Converter={StaticResource CountToVis}}" />
        </Grid>

        <!-- 底部动作 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
          <Button Content="归档" Style="{StaticResource GhostBtn}" Click="OnArchived" />
          <Button Content="记忆" Style="{StaticResource GhostBtn}" Click="OnMemories" />
          <Button Content="技能" Style="{StaticResource GhostBtn}" Click="OnTools" />
          <Button Content="用量" Style="{StaticResource GhostBtn}" Click="OnUsage" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ============ 主区 ============ -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- 顶栏 -->
      <Border Grid.Row="0" BorderBrush="{x:Static local:Theme.BorderSoft}" BorderThickness="0,0,0,1"
              Background="{x:Static local:Theme.BgWindow}" Padding="20,12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Orientation="Horizontal">
            <TextBlock x:Name="ChatTitle" Text="新对话"
                       FontSize="{x:Static local:Theme.FontChatTitle}" FontWeight="SemiBold"
                       Foreground="{x:Static local:Theme.TextMain}" VerticalAlignment="Center" />
            <TextBlock x:Name="ArchivedBadge" Text="· 归档" FontSize="{x:Static local:Theme.FontSmall}"
                       Foreground="{x:Static local:Theme.TextMuted}" Margin="8,3,0,0"
                       VerticalAlignment="Center" Visibility="Collapsed" />
          </StackPanel>
          <Border Grid.Column="1" Background="{x:Static local:Theme.BgAlt}"
                  CornerRadius="9" Padding="10,4" VerticalAlignment="Center">
            <TextBlock x:Name="ModelBadge" FontSize="{x:Static local:Theme.FontSmall}"
                       Foreground="{x:Static local:Theme.TextSoft}" Text="—" />
          </Border>
        </Grid>
      </Border>

      <!-- 聊天区 -->
      <Grid Grid.Row="1" Background="{x:Static local:Theme.BgWindow}">
        <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="24,16,20,8">
          <ItemsControl x:Name="ChatList" ItemsSource="{Binding Blocks}"
                        ItemTemplate="{StaticResource ChatItem}" />
        </ScrollViewer>

        <!-- 空态欢迎页 -->
        <StackPanel x:Name="Welcome" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding Blocks.Count, Converter={StaticResource CountToVis}}">
          <TextBlock x:Name="WelcomeLine1" Text="有什么可以帮你的？"
                     FontSize="24" FontWeight="Light" HorizontalAlignment="Center"
                     Foreground="{x:Static local:Theme.TextMain}" />
          <TextBlock Text="用火焰点亮想法 · 灵感稍纵即逝"
                     FontSize="{x:Static local:Theme.FontBody}"
                     Foreground="{x:Static local:Theme.TextMuted}"
                     HorizontalAlignment="Center" Margin="0,10,0,0" />
        </StackPanel>
      </Grid>

      <!-- 输入区 + 状态栏 -->
      <Border Grid.Row="2" Background="{x:Static local:Theme.BgWindow}"
              BorderBrush="{x:Static local:Theme.BorderSoft}" BorderThickness="0,1,0,0"
              Padding="20,12,20,8">
        <StackPanel>
          <Border x:Name="InputShell" Background="{x:Static local:Theme.BgSoft}"
                  BorderBrush="{x:Static local:Theme.BorderSoft2}" BorderThickness="1"
                  CornerRadius="12" Padding="14,10,10,8">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <Grid Grid.Row="0" Grid.Column="0">
                <TextBox x:Name="InputBox" Style="{StaticResource ChatInput}"
                         MinHeight="42" MaxHeight="180" Padding="0,2"
                         KeyDown="OnInputKeyDown" TextChanged="OnInputTextChanged" />
                <TextBlock x:Name="InputPlaceholder" Text="给 Flare 发消息…（Enter 发送，Shift+Enter 换行）"
                           FontSize="{x:Static local:Theme.FontBody}"
                           Foreground="{x:Static local:Theme.TextFaint}"
                           IsHitTestVisible="False" Margin="2,4,0,0" />
              </Grid>

              <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button x:Name="StopButton" Content="⏹ 停止" Style="{StaticResource StopBtn}"
                        Margin="8,0,0,0" Click="OnStop" Visibility="Collapsed" />
                <Button x:Name="SendButton" Content="发送" Style="{StaticResource PrimaryBtn}"
                        Margin="8,0,0,0" Click="OnSend" />
              </StackPanel>

              <TextBlock Grid.Row="1" Grid.ColumnSpan="2" x:Name="HintLine" Margin="2,6,0,0"
                         FontSize="{x:Static local:Theme.FontFootnote}"
                         Foreground="{x:Static local:Theme.TextFaint}" Text="" />
            </Grid>
          </Border>

          <!-- 状态栏 -->
          <Grid Margin="4,8,4,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
              <Border x:Name="StatusDot" Width="7" Height="7" CornerRadius="4"
                      Background="{x:Static local:Theme.TextFaint}" VerticalAlignment="Center" />
              <TextBlock x:Name="StatusLabel" Text="未启动" Margin="6,0,0,0"
                         FontSize="{x:Static local:Theme.FontFootnote}"
                         Foreground="{x:Static local:Theme.TextMuted}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Grid.Column="2" x:Name="RightStatus" Text=""
                       FontSize="{x:Static local:Theme.FontFootnote}"
                       Foreground="{x:Static local:Theme.TextFaint}" VerticalAlignment="Center" />
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
