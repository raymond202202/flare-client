<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Flare Windows 壳（WPF / .NET Framework 4.8）

    为什么是 .NET Framework 4.8 而不是 .NET 8：
      Win10 1809+ / Win11 全部自带 4.8 运行时，用户**零安装**；
      而 .NET 8 Desktop Runtime 需要用户额外装 55MB，违反「把用户当傻子」原则。
      包体：壳 ~500KB + 内置引擎 flare.exe ~11MB ≈ 12MB，低于飞书 20MB 单文件上限。

    构建：GitHub Actions windows-latest（msbuild 自带 4.8 targeting pack），
          见 .github/workflows/native-windows.yml。
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 双目标框架，一套源码出两个安装包：
           net452          = 标准版（主推），门槛低到「系统里随便有个 .NET 4.5.2 就行」，
                             包 ~4MB。Win7 SP1 上装的 .NET 4.x 通常就是 4.5.2/4.6.2/4.7.2，
                             全都能跑；Win10/11 自带 4.6+，更是零安装。
                             以前这里写的是 net48，会生成 sku=v4.8 的 Flare.exe.config，
                             Win7 用户一启动就被 Windows 弹「需要 .NET Framework v4.8」——
                             那个弹窗不是我们装的检查，是 config 里那行 sku 招来的。
                             实测 net452/net462/net472/net48 四档编译产物完全一致（88,064 B），
                             说明代码根本没用到 4.6+ 的 API，门槛白抬了。
           net6.0-windows = 极老系统兜底（系统连 .NET 4.5.2 都没有时用），自包含发布把
                            CoreCLR+WPF+UCRT 全打进包，包 ~41MB。主流程不再推这个包。
         net6.0-windows（不带 7.0/10.0 后缀）等价于最低 Windows 7。
         .NET 6 是最后一个支持 Win7 SP1 的桌面运行时；它已 EOL，但没有安全风险面扩大：
         所有网络与 LLM 通信都在独立的 Go 引擎进程里，这个壳只做 UI + 本地 IPC。 -->
    <TargetFrameworks>net452;net6.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <!-- net48 不需要 RuntimeIdentifier（那是 .NET Core/5+ 自包含的概念），留着反而触发 RID 解析告警 -->
    <AssemblyName>Flare</AssemblyName>
    <RootNamespace>FlareWin</RootNamespace>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Deterministic>true</Deterministic>
    <!-- 版本号的唯一来源是仓库根 CMakeLists.txt 的 project(... VERSION x.y.z)。
         CI 用 -p:Version= 从那里取值覆盖，这里只是本地直接 msbuild 时的兜底值。
         别再让兜底值落后于 CMakeLists —— 0.6.163 挂了很久，本地编出来的 exe
         属性里写着 0.6.163，而安装包叫 0.6.19x，等于两个假版本号。 -->
    <Version>0.6.191</Version>
    <FileVersion>0.6.191.0</FileVersion>
    <AssemblyVersion>0.6.191.0</AssemblyVersion>
    <Product>Flare</Product>
    <Company>Flare</Company>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <!-- 单文件外观：无控制台窗口 -->
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- 兼容版（自包含）专属：net48 分支不要这些属性，否则 msbuild 会去解析 RID -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net6.0-windows'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- 不开 InvariantGlobalization：Windows 上 .NET 走 NLS 不打包 ICU，省不了体积，
         却会把日期/数字格式化变成英文习惯，中文界面反而变味 -->
    <!-- 允许在 Linux/macOS 上交叉发布（CI 与本地构建都用得上） -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!-- net452 的引用程序集作为 NuGet 包显式引入：
       多目标框架项目 restore 会同时 restore 各档，而跑 CI 的 SDK 未必带
       .NET Framework targeting pack。显式引入后任何 SDK / 任何操作系统都能
       restore 通过，不依赖 VS 装了什么。 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net452'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- 内置引擎目录：build.ps1 把 flare.exe 拷到 engine\ 下，此处仅标记为内容不入编译 -->
  <ItemGroup>
    <!-- 用 Update 而不是 Include：SDK 风格项目已默认把所有文件收进 None，
         Include 会造成 NETSDK1022 重复项。engine\ 下的 exe 需随输出复制。 -->
    <None Update="engine\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
