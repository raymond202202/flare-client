<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:FlareWin">

  <!-- 转换器 -->
  <local:BoolToVis x:Key="BoolToVis" />
  <local:EmptyToVis x:Key="EmptyToVis" />
  <local:CountToVis x:Key="CountToVis" />

  <!-- ========== 按钮：主行动（明亮紫橙渐变主色） ========== -->
  <Style x:Key="PrimaryBtn" TargetType="Button">
    <Setter Property="Background" Value="{x:Static local:Theme.Orange}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontSize" Value="{x:Static local:Theme.FontList}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="16,7" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}"
                  CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{x:Static local:Theme.BtnHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{x:Static local:Theme.BtnPressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="bd" Property="Background" Value="{x:Static local:Theme.BtnDisabled}" />
              <Setter Property="Foreground" Value="{x:Static local:Theme.TextMuted}" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ========== 按钮：幽灵（侧栏/次级操作） ========== -->
  <Style x:Key="GhostBtn" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{x:Static local:Theme.TextSoft}" />
    <Setter Property="FontSize" Value="{x:Static local:Theme.FontList}" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}"
                  CornerRadius="7" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{x:Static local:Theme.BgAlt}" />
              <Setter Property="Foreground" Value="{x:Static local:Theme.TextMain}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{x:Static local:Theme.HoverSoft}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ========== 按钮：停止（白底红描边，与发送互斥显示） ========== -->
  <Style x:Key="StopBtn" TargetType="Button">
    <Setter Property="Background" Value="White" />
    <Setter Property="Foreground" Value="{x:Static local:Theme.Red}" />
    <Setter Property="BorderBrush" Value="{x:Static local:Theme.StopBorder}" />
    <Setter Property="FontSize" Value="{x:Static local:Theme.FontList}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                  CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{x:Static local:Theme.StopHoverBg}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{x:Static local:Theme.StopPressedBg}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ========== 侧栏会话项 ========== -->
  <Style x:Key="SideItem" TargetType="ListBoxItem">
    <!-- 内距 / 圆角 / 悬停 / 选中四组值逐字对齐 Qt 侧 QSS（sessionlistwidget.cpp:217-219）：
         item{padding:8px 6px;border-radius:6px;margin:1px}、item:hover{#ffedd0}、item:selected{#f97316;color:white}。
         两平台同一套观感，改一端必须同步另一端。 -->
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="bd" Background="Transparent" CornerRadius="6"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <!-- 这里只能用列表项自身的 Trigger（IsMouseOver / IsSelected 都是 ListBoxItem 的
                 依赖属性）。别改成 MultiDataTrigger 去附带一个 {Binding IsHeader} 条件来排除
                 分组标题：条件里的 DataContext 绑定在模板触发器下解析不到，整组条件恒不成立，
                 悬停和选中会一起哑掉，表现就是列表里怎么点都没有高亮。
                 标题行改在 Style.Triggers 里设 IsHitTestVisible=False 挡掉，见下。 -->
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#ffedd0" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#f97316" />
              <!-- 白字不在这里设：标题/时间两段文字各有自己的 Style，
                   它们的 DataTrigger 绑 AncestorType=ListBoxItem 的 IsSelected 直接变白。 -->
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <!-- 分组标题行不是会话：不可点、不可聚焦、不抢方向键、不弹悬停色。
           走 IsEnabled=False 而不是在回调里判空 —— 直接在输入层拦掉，
           键盘上下键和 Shift 连选都会自己跳过它，不用在每处回调补守卫。 -->
      <DataTrigger Binding="{Binding IsHeader}" Value="True">
        <Setter Property="IsEnabled" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <!-- 挡在鼠标命中层：禁用元素 IsMouseOver 仍为真，光靠 IsEnabled=False
             标题行被划过仍会亮 hover 色。IsHitTestVisible=False 之后鼠标彻底无视它。 -->
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="Padding" Value="8,9,6,3" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- ========== 多行输入框（圆角，无默认边框） ========== -->
  <Style x:Key="ChatInput" TargetType="TextBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{x:Static local:Theme.TextMain}" />
    <Setter Property="CaretBrush" Value="{x:Static local:Theme.Orange}" />
    <Setter Property="FontSize" Value="{x:Static local:Theme.FontBody}" />
    <Setter Property="TextBoxBase.IsUndoEnabled" Value="True" />
    <Setter Property="AcceptsReturn" Value="True" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}"
                        VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ========== 卡片容器 ========== -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{x:Static local:Theme.BgSoft}" />
    <Setter Property="BorderBrush" Value="{x:Static local:Theme.BorderSoft}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="14,12" />
  </Style>
  <!-- ========== 右键菜单 ==========
       对齐 Qt 0.6.191 FlareMenu：白底、1px 暖描边、10px 圆角，选中项浅橙圆角块。
       模板必须重写 —— WPF 默认 ContextMenu 顶部有一条系统色边框、左侧留 22px 图标槽，
       在浅橙底界面上是两块显眼的异色。外层 Margin=8 是给 DropShadowEffect 留出血位，
       不留的话阴影会被 Popup 边界裁掉一半，看着像脏了。 -->
  <Style x:Key="FlareMenu" TargetType="ContextMenu">
    <Setter Property="Background" Value="{x:Static local:Theme.BgWindow}" />
    <Setter Property="Foreground" Value="{x:Static local:Theme.TextMain}" />
    <Setter Property="FontSize" Value="{x:Static local:Theme.FontList}" />
    <Setter Property="BorderBrush" Value="{x:Static local:Theme.BorderSoft}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="5" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border x:Name="MenuShell"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="10" Padding="{TemplateBinding Padding}" Margin="8">
            <Border.Effect>
              <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270"
                                Opacity="0.16" Color="#4a2e0d" />
            </Border.Effect>
            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 菜单项：隐式样式（无 x:Key）。菜单里只会出现一级项，所以模板不需要
       Popup/子菜单分支 —— 换来的是一条能完整控制圆角与 hover 色的行。 -->
  <Style TargetType="MenuItem">
    <Setter Property="FontSize" Value="{x:Static local:Theme.FontList}" />
    <Setter Property="Foreground" Value="{x:Static local:Theme.TextMain}" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="bd" Background="Transparent" CornerRadius="7"
                  Padding="{TemplateBinding Padding}" Margin="2,1">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="txt" Grid.Column="0" Text="{TemplateBinding Header}"
                         Foreground="{TemplateBinding Foreground}"
                         FontSize="{TemplateBinding FontSize}"
                         FontFamily="{x:Static local:Theme.FontEmojiFamily}"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="1" Text="{TemplateBinding InputGestureText}"
                         Foreground="{x:Static local:Theme.TextFaint}"
                         FontSize="{x:Static local:Theme.FontSmall}"
                         Margin="20,0,2,0" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{x:Static local:Theme.HoverSoft}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="txt" Property="Foreground" Value="{x:Static local:Theme.TextFaint}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 分隔线：默认 Separator 在浅色底上是准黑 1px，太硬；改成暖描边色 + 左右留白。 -->
  <Style TargetType="Separator">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Border Height="1" Margin="10,5" Background="{x:Static local:Theme.BorderSoft}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
